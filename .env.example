# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=generate-a-long-random-string-here-min-32-chars

# ─── Maintenance Mode ──────────────────────────────────────────────────────────
# Workflow: set MAINTENANCE_MODE=true → restart app → run migrations → set false → restart app
#
# Restart commands (either works):
#   docker compose restart app      ← uses service name from docker-compose.yml
#   docker restart lumos_app        ← uses container name directly
#
# Endpoints always available during maintenance:
#   GET /health  →  { "status": "maintenance" | "ok" }
#   POST /api/auth/login  (so admins can log in for bypass)
#   /iclock/*  (biometric — see MAINTENANCE_BLOCK_BIOMETRIC below)
MAINTENANCE_MODE=false

# Set to 'true' to let root_admin accounts bypass maintenance (JWT decoded, no DB query).
MAINTENANCE_ADMIN_BYPASS=false

# Set to 'true' to ALSO block biometric ADMS endpoints (/iclock/*) during maintenance.
# Use this when migrating attendance-related tables to prevent write conflicts.
# ZKTeco devices buffer locally and will re-push data after maintenance ends.
MAINTENANCE_BLOCK_BIOMETRIC=false

# Optional custom message displayed on the maintenance page and in API 503 responses.
# Leave blank to use the default message.
# Example: "Scheduled database upgrade. Expected downtime: 20 minutes."
MAINTENANCE_MESSAGE=

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Local dev:    postgresql://lumos_admin:yourpass@localhost:5432/lumos_hrms
# Hostinger:   postgresql://lumos_admin:yourpass@YOUR_VPS_IP:5432/lumos_hrms
# AWS RDS:     postgresql://lumos_admin:yourpass@xxx.ap-south-1.rds.amazonaws.com:5432/lumos_hrms
DATABASE_URL=postgresql://lumos_admin:yourpassword@localhost:5432/lumos_hrms
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumos_hrms
DB_USER=lumos_admin
DB_PASSWORD=yourpassword

# ─── Supabase (keep until PostgreSQL migration fully complete) ─────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (Google Workspace / Gmail SMTP) ─────────────────────────────────────
# Uses smtp.gmail.com:587 (hardcoded in emailService.js)
# App Password: Google Account → Security → 2FA → App Passwords
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=xxxx xxxx xxxx xxxx
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
HR_EMAIL=hr@yourdomain.com
COMPANY_HEAD_1_EMAIL=ceo@yourdomain.com
COMPANY_HEAD_2_EMAIL=coo@yourdomain.com

# ─── Google Calendar ───────────────────────────────────────────────────────────
# calendar.google.com → Settings → Integrate calendar → Calendar ID
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# For cloud deployments (paste service-account.json as single line):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Cloudinary (document & receipt uploads) ───────────────────────────────────
# cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate keys once:
# node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── BGV (SpringVerify) — optional; feature `bgv` is OFF per organization until a Platform Admin enables it ──
# BGV_PROVIDER_MODE=springverify   # 'springverify' (real) | 'mock' (dev/test only — refused when NODE_ENV=production). Unset = BGV unusable.
# SPRINGVERIFY_BASE_URL=https://api-acceptance-2-sa.in.springverify.com   # sandbox; production: https://api-sa.in.springverify.com
# SPRINGVERIFY_API_TOKEN=          # API bearer token from SpringVerify (per environment); server-side only
# SPRINGVERIFY_PACKAGE_IDENTIFIER= # integer subtype_id from GET /external/v1/candidate/packages (differs per environment)
# SPRINGVERIFY_WEBHOOK_SECRET=     # secret you choose; SpringVerify sends it as 'Authorization: Bearer <secret>' to /api/bgv/webhook
